{
    "//": "Scoop bucket manifest for coco (npm package `git-coco`). Canonical source — see packaging/README.md for the one-time bucket setup and how this gets regenerated + published on release.",
    "version": "0.87.0",
    "description": "AI-powered git assistant: commits, changelogs, reviews, and a terminal workstation",
    "homepage": "https://coco.griffen.codes",
    "license": "MIT",
    "depends": "nodejs-lts",
    "url": "https://registry.npmjs.org/git-coco/-/git-coco-0.87.0.tgz",
    "hash": "sha256:0db09c65cc472b550c98ff4609bfcfc8f8a763435aa58a44e753c6cf3f0d165e",
    "installer": {
        "script": [
            "Push-Location \"$dir\"",
            "& npm install --global --prefix \"$dir\" --production --no-save --loglevel=error \"$dir\\package\"",
            "Pop-Location"
        ]
    },
    "uninstaller": {
        "script": [
            "& npm uninstall --global --prefix \"$dir\" git-coco --loglevel=error"
        ]
    },
    "bin": "coco.cmd",
    "checkver": {
        "url": "https://registry.npmjs.org/git-coco/latest",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "url": "https://registry.npmjs.org/git-coco/-/git-coco-$version.tgz"
    }
}
